{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/v1/cron/ingest",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/v1/cron/aggregate",
      "schedule": "0 3 * * *"
    }
  ]
}
