{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/v1/cron/ingest/free",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/v1/cron/ingest/paid",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/v1/cron/ingest/scrape",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/v1/cron/aggregate",
      "schedule": "0 3 * * *"
    }
  ]
}
